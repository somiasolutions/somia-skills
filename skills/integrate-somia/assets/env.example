# Somia — copy to your project `.env.example`. Never commit real secrets.

SOMIA_API_KEY=
SOMIA_BASE_URL=https://platform.somiasolutions.com/api

# External agent monitoring / local eval (slug string)
SOMIA_AGENT_SLUG=
# Legacy alias used by some projects (optional)
# SOMIA_AGENT_ID=

SOMIA_AGENT_VERSION=
SOMIA_MONITORING_ENABLED=true

# Evaluation (UUIDs from the Somia dashboard)
SOMIA_DATASET_ID=
SOMIA_PROFILE_ID=
